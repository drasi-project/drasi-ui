{
  "name": "@drasi/ui-core",
  "version": "0.1.0-beta.1",
  "description": "Framework-neutral Drasi query contracts, state, transports and optional read-only Server adapter.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "The Drasi Authors",
  "homepage": "https://github.com/drasi-project/drasi-ui#readme",
  "repository": {"type": "git", "url": "git+https://github.com/drasi-project/drasi-ui.git", "directory": "packages/core"},
  "bugs": {"url": "https://github.com/drasi-project/drasi-ui/issues"},
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {"types": "./dist/index.d.ts", "default": "./dist/index.js"},
      "require": {"types": "./dist/index.d.cts", "default": "./dist/index.cjs"}
    },
    "./adapters/drasi-server": {
      "import": {"types": "./dist/adapters/drasi-server/index.d.ts", "default": "./dist/adapters/drasi-server/index.js"},
      "require": {"types": "./dist/adapters/drasi-server/index.d.cts", "default": "./dist/adapters/drasi-server/index.cjs"}
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE", "NOTICE"],
  "sideEffects": false,
  "scripts": {"build": "tsup", "typecheck": "tsc --noEmit"},
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"}
}
