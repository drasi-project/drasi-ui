{
  "name": "drasi-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@11.17.0",
  "workspaces": ["packages/core", "packages/styles", "packages/react", "examples/react", "examples/vue-canary", "tests/consumers/react-18", "tests/consumers/react-19"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/check-boundaries.mjs",
    "typecheck": "npm run typecheck -w @drasi/ui-core -w @drasi/react && tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run && node --test tests/consumers/public-contract/*-check.mjs scripts/test/*.test.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "node scripts/packed-consumers.mjs",
    "test:pnpm": "node scripts/pnpm-consumer.mjs",
    "test:browser": "playwright test",
    "check:packages": "node scripts/check-packages.mjs",
    "check:changesets": "node scripts/check-changesets.mjs",
    "pack:candidates": "node scripts/pack.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version && npm install --package-lock-only --ignore-scripts --registry=https://registry.npmjs.org",
    "release:prepare": "npm run build && npm run pack:candidates && npm run check:packages && npm run test:contracts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.3",
    "@axe-core/playwright": "4.10.2",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "20.19.11",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "26.1.0",
    "publint": "0.3.25",
    "pnpm": "12.14.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
