{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": false,
    "esModuleInterop": true,
    "noEmit": true,
    "plugins": [{"name": "next"}]
  },
  "include": ["src", "app", ".generated", ".next/types/**/*.ts"]
}
